# URL of the API (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of the API media host used by next/image (no path).
# Must match the API's MEDIA_PUBLIC_BASE_URL. Development defaults to
# http://localhost:4000 when empty; staging and production must set it.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Public origin of this web app (for example https://shop.example.com).
# Must match the origin users visit; the admin same-origin check compares
# Origin/Sec-Fetch-Site against this value. Behind a tunnel or proxy, use the
# public origin, not the internal container URL.
NEXT_PUBLIC_SITE_URL=

# Environment mode (not secret): development, staging, or production.
# When empty: development unless NODE_ENV=production, then production.
NEXT_PUBLIC_APP_ENV=

# Secret key used server-side to skip the public API rate limit (sent as the
# "x-storefront-key" header from Next.js route handlers / server fetches).
# Must match STOREFRONT_API_KEY on the API. Never expose this to the browser.
STOREFRONT_API_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
