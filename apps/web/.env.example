# URL of the API (apps/api). In production this is the Render URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Secret key used server-side to skip the public API rate limit (sent as the
# "x-storefront-key" header from Next.js route handlers / server fetches).
# Must match STOREFRONT_API_KEY on the API. Never expose this to the browser.
STOREFRONT_API_KEY=

# Supabase project URL and anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
