# --- API server ---
PORT=4000
NODE_ENV=development

# --- Database (Supabase Postgres) ---
# IMPORTANT: Use the Supabase SESSION POOLER connection string (host looks like
# aws-0-<region>.pooler.supabase.com, port 5432) -- NOT the transaction pooler
# on port 6543. Render's free tier is IPv4-only and Supabase's direct
# connection is IPv6, so the session pooler is required.
DATABASE_URL=

# --- Supabase (used later for Storage and Auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Admin bootstrap ---
# Used only by `pnpm --filter @zayn/api admin:create-owner`.
OWNER_EMAIL=

# --- CORS ---
# Origin allowed to call the API (the deployed web app in production).
WEB_ORIGIN=http://localhost:3000

# --- Storefront rate-limit bypass ---
# Optional. When set, requests to /api/public with a matching
# "x-storefront-key" header skip the 120/minute/IP rate limit
# (used by the Next.js server fetching catalog data server-side).
STOREFRONT_API_KEY=
