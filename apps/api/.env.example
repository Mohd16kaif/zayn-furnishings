# --- API server ---
PORT=4000
NODE_ENV=development

# --- Environment mode ---
# development, staging, or production. When empty: development unless
# NODE_ENV=production, then production.
APP_ENV=

# --- Database ---
# Plain PostgreSQL (docker-compose.dev.yml):
#   postgres://zayn_dev:zayn_dev_local@127.0.0.1:5433/zayn_dev
DATABASE_URL=
# Optional: "require" or "disable". Leave empty to keep the driver default
# (including any sslmode in DATABASE_URL). Use "disable" for the local
# container.
DATABASE_SSL=

# --- Media storage ---
# Uploaded images are written under MEDIA_DIR and served from /media.
# Required outside development. Development defaults to
# <repo>/apps/api/media-data when empty. Must be an absolute path.
MEDIA_DIR=
# Public origin used to build absolute image URLs. Required outside
# development. Development defaults to http://localhost:4000 when empty.
MEDIA_PUBLIC_BASE_URL=
# Local uploads are refused below this much free space on the media volume.
MEDIA_MIN_FREE_MB=500

# --- Admin auth ---
# Admin email-code login and session signing secret. Required in staging and
# production; at least 32 characters. In development only, an empty value uses
# a built-in dev-only fallback and logs a warning. Never commit a real secret.
ADMIN_AUTH_SECRET=

# --- Admin bootstrap ---
# Used only by `pnpm --filter @zayn/api admin:create-owner`.
OWNER_EMAIL=

# --- CORS ---
# Origin allowed to call the API (the deployed web app in production).
WEB_ORIGIN=http://localhost:3000

# --- Transactional email ---
# Optional. When both are set, email is sent through Resend. Otherwise the
# API uses the log-only sender and does not make network calls.
RESEND_API_KEY=
EMAIL_FROM=

# --- Storefront rate-limit bypass ---
# Optional. When set, requests to /api/public with a matching
# "x-storefront-key" header skip the 120/minute/IP rate limit
# (used by the Next.js server fetching catalog data server-side).
STOREFRONT_API_KEY=

# --- Stripe ---
# Required in production. Optional in development so the API can boot.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio Verify ---
# Optional. When all three are set, Twilio Verify handles phone sign-in.
# In non-production without them the API uses the fixed dev stub code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
