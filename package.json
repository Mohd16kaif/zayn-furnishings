{
  "name": "zayn-furnishings",
  "version": "0.1.0",
  "private": true,
  "description": "US-only furniture e-commerce store (monorepo)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @zayn/shared build && concurrently -n web,api -c cyan,magenta \"pnpm --filter web dev\" \"pnpm --filter @zayn/api dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @zayn/shared build && pnpm -r --if-present test",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:price-change": "node scripts/check-price-change.mjs",
    "check:e2e": "node scripts/check-e2e.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "docker:build:api": "node scripts/docker-build.mjs api",
    "docker:build:web": "node scripts/docker-build.mjs web",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "docker:stack:init": "node scripts/compose-init-env.mjs",
    "docker:stack:up": "node scripts/docker-stack.mjs up",
    "docker:stack:up:tunnel": "node scripts/docker-stack.mjs up-tunnel",
    "docker:stack:up:quick": "node scripts/docker-stack.mjs up-quick",
    "docker:stack:down": "node scripts/docker-stack.mjs down",
    "docker:stack:logs": "node scripts/docker-stack.mjs logs",
    "docker:stack:reset": "node scripts/docker-stack.mjs reset",
    "docker:stack:smoke": "node scripts/docker-stack.mjs smoke",
    "docker:backup:run": "node scripts/docker-backup.mjs run",
    "docker:backup:list": "node scripts/docker-backup.mjs list",
    "docker:restore": "node scripts/docker-restore.mjs",
    "docker:backup:drill": "node scripts/docker-backup-drill.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "start": "pnpm --filter @zayn/api start",
    "db:generate": "pnpm --filter @zayn/api db:generate",
    "db:migrate": "pnpm --filter @zayn/api db:migrate",
    "db:dev:up": "node scripts/dev-db.mjs up",
    "db:dev:down": "node scripts/dev-db.mjs down",
    "db:dev:reset": "node scripts/dev-db.mjs reset"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
