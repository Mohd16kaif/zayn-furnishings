# Compose stack environment for docker-compose.stack.yml.
# Copy with `pnpm docker:stack:init`; that command creates .env.compose and
# refuses to overwrite an existing file. Never commit .env.compose.
#
# Values marked "build-time" are Docker build args for the web image, so a
# change requires a rebuild. All other values are runtime environment.

# --- PostgreSQL (postgres + api + migrate) ---
# Use alphanumeric values only. POSTGRES_PASSWORD is embedded in DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Runtime mode ---
# development avoids production-only Stripe validation. Use production for the
# HTTPS tunnel: the admin and customer cookies set Secure only when
# NODE_ENV=production. Local HTTP development keeps the cookies usable.
NODE_ENV=
# App mode used by shared code and API validation: development/staging/production.
APP_ENV=

# --- Edge ---
# Only the edge publishes a host port, on 127.0.0.1.
EDGE_HOST_PORT=
# HSTS max-age in seconds. Sent only when the request arrived as HTTPS.
# Start at 300, then raise after HTTPS is verified: 86400, 2592000, 15552000.
HSTS_MAX_AGE=

# --- Cloudflare Tunnel (profile: tunnel) ---
# Required only for `pnpm docker:stack:up:tunnel`; ignored by the quick tunnel.
# Create the tunnel in the Cloudflare Zero Trust dashboard, add a public
# hostname mapping to http://edge:80, copy the tunnel token, and paste it here.
# It is passed to cloudflared as an environment variable, never on the command
# line. Never commit this file or print the token.
TUNNEL_TOKEN=
# cloudflared edge IP version: auto, 4, or 6. Leave blank to use auto.
# Try auto or 6 if the VPS only has IPv6 outbound (unverified).
TUNNEL_EDGE_IP_VERSION=

# --- Web public values (build-time for the web image) ---
# These are baked into the Next build. They must be the public edge origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- API media (runtime) ---
# Must match the public edge origin so image URLs work through Caddy.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MIN_FREE_MB=

# --- API CORS and shared server key (runtime) ---
WEB_ORIGIN=
# The SAME value is passed to api and web.
STOREFRONT_API_KEY=

# --- Admin bootstrap (runtime, api) ---
# Used by the compiled createOwner command, not by the API server.
OWNER_EMAIL=

# --- Stripe (runtime, api) ---
# Required when NODE_ENV=production. Leave blank for local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (runtime, api) ---
# Leave blank to use the log-only sender in development.
RESEND_API_KEY=
EMAIL_FROM=

# --- Twilio Verify (runtime, api) ---
# Optional; development uses the fixed test flow when these are blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Web server-only Apple Pay file (runtime) ---
APPLE_PAY_DOMAIN_ASSOCIATION=

# --- Encrypted backups (profile: backup) ---
# Losing RESTIC_PASSWORD makes every backup unreadable. Store it in the client's
# password manager and keep an offline copy. This file is NOT backed up.
# RESTIC_REPOSITORY: /repo uses the local Docker volume (development only, not an
# off-server backup). For real backups use an S3-compatible bucket or sftp, for
# example s3:https://s3.us-west-004.backblazeb2.com/zayn-backups or
# sftp:backup@host:/srv/restic/zayn.
RESTIC_REPOSITORY=
# Long random alphanumeric value. Generated by pnpm docker:stack:init for new
# env files. Never commit it and never paste it into a command line.
RESTIC_PASSWORD=
# Only for an S3-compatible repository. Leave blank for a local path or sftp.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Retention: restic forget --prune keeps this many daily/weekly/monthly
# snapshots. The newest snapshot is always kept.
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=
BACKUP_KEEP_MONTHLY=
# Optional deeper repository check after every run. Blank disables it. Examples:
# 5% (five percent of packs) or 1/10 (one tenth). The metadata check always runs.
BACKUP_READ_DATA_SUBSET=
# Optional healthcheck ping URL. After success the backup GETs the URL; on
# failure it GETs the URL with /fail appended. The URL is never printed.
HEALTHCHECK_PING_URL=
