# Compose stack environment for docker-compose.stack.yml.
# Copy with `pnpm docker:stack:init`; that command creates .env.compose and
# refuses to overwrite an existing file. Never commit .env.compose.
#
# Values marked "build-time" are Docker build args for the web image, so a
# change requires a rebuild. All other values are runtime environment.

# --- PostgreSQL (postgres + api + migrate) ---
# Use alphanumeric values only. POSTGRES_PASSWORD is embedded in DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Runtime mode ---
# development avoids production-only Stripe validation. Use production only
# with TLS, real service secrets, and secure-cookie settings (Phase 10).
NODE_ENV=
# App mode used by shared code and API validation: development/staging/production.
APP_ENV=

# --- Edge ---
# Only the edge publishes a host port, on 127.0.0.1.
EDGE_HOST_PORT=

# --- Web public values (build-time for the web image) ---
# These are baked into the Next build. They must be the public edge origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- API media (runtime) ---
# Must match the public edge origin so image URLs work through Caddy.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MIN_FREE_MB=

# --- API CORS and shared server key (runtime) ---
WEB_ORIGIN=
# The SAME value is passed to api and web.
STOREFRONT_API_KEY=

# --- Admin bootstrap (runtime, api) ---
# Used by the compiled createOwner command, not by the API server.
OWNER_EMAIL=

# --- Stripe (runtime, api) ---
# Required when NODE_ENV=production. Leave blank for local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (runtime, api) ---
# Leave blank to use the log-only sender in development.
RESEND_API_KEY=
EMAIL_FROM=

# --- Twilio Verify (runtime, api) ---
# Optional; development uses the fixed test flow when these are blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Web server-only Apple Pay file (runtime) ---
APPLE_PAY_DOMAIN_ASSOCIATION=
